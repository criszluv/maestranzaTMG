# DEPENDENCIAS (cubre raiz y subcarpetas)
node_modules/
.venv/
venv/

# BUILDS / ARTEFACTOS
dist/
build/
__pycache__/
*.py[cod]

# EJECUTABLE (Electron): se ignora node_modules/ y dist/ (via reglas de arriba),
# pero el icono y su script generador SI deben versionarse para poder recompilar.
!ejecutable/build/
ejecutable/build/*
!ejecutable/build/icon.ico
!ejecutable/build/generar-icono.ps1

# FRONTEND (Vite + React)
frontend/node_modules
frontend/dist

# BACKEND (Python + FastAPI)
backend/.venv

# ARCHIVOS DE ENTORNO / SECRETOS (nunca subir credenciales reales)
.env
*.env
.env.*
frontend/.env.local
# Las plantillas SIN secretos si se versionan:
!backend/.env.example
!**/.env.example

# SISTEMA / EDITOR
.DS_Store
Thumbs.db
*.log
