# Plantilla de variables del frontend (Vite). Copia a .env.local en desarrollo
# o configúralas en Vercel (Project Settings -> Environment Variables).
#
# URL base del backend FastAPI. El cliente le agrega /api automáticamente.
#   - Desarrollo local: http://127.0.0.1:8000 (valor por defecto si se omite)
#   - Producción: la URL pública de tu backend con HTTPS.
# El backend debe incluir el dominio de Vercel en CORS_ORIGINS.
VITE_API_URL=https://tu-backend.ejemplo.cl

# Alternativa: define directamente la URL COMPLETA incluyendo /api.
# Si se define, tiene prioridad sobre VITE_API_URL.
# VITE_API_BASE_URL=https://tu-backend.ejemplo.cl/api
