# Plantilla de variables de entorno. Copia este archivo como `.env` y rellena
# tus valores reales. NO subas el .env real al repositorio (ya está en .gitignore).

# --- Base de datos (Supabase / Postgres) ---
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:6543/postgres
DB_SSLMODE=require

# --- Pool de conexiones SQLAlchemy (opcional) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Seguridad / JWT ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_SECRETA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Política de cuentas (opcional, estos son los valores por defecto) ---
# Longitud mínima de contraseña. Para cuentas privilegiadas se recomienda 12+.
# La fortaleza (mayús/minús/dígitos/símbolos, blocklist, secuencias, que no
# contenga el correo) se aplica siempre en app/core/passwords.py.
# PASSWORD_MIN_LARGO=8
# Rate limit de login por (IP+correo): frena fuerza bruta contra una cuenta.
# LOGIN_MAX_INTENTOS=5
# LOGIN_VENTANA_SEGUNDOS=300
# Rate limit de login por IP: frena el "password spraying" (una clave contra
# muchas cuentas desde la misma IP).
# LOGIN_MAX_INTENTOS_IP=20

# --- Hardening HTTP (opcional) ---
# HSTS (fuerza HTTPS en el navegador). En segundos; 0 lo desactiva (útil solo
# si un reverse proxy ya inyecta la cabecera). Default: 63072000 (2 años).
# HSTS_MAX_AGE=63072000

# --- Solicitudes / Vacaciones (opcional, valores por defecto) ---
# Días de vacaciones por año para cada trabajador (Chile: 15 días hábiles).
# VACACIONES_DIAS_ANUALES=15
# Solo las solicitudes de este tipo (aprobadas) descuentan del saldo.
# VACACIONES_TIPO=Vacaciones
# Tamaño máximo del adjunto (foto-documento) de una solicitud.
# SOLICITUD_ADJUNTO_MAX_BYTES=5242880    # 5 MB

# --- CORS (orígenes del frontend, separados por coma) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crear tablas automáticamente al arrancar (true/false)
AUTO_CREATE_TABLES=false

# --- Workera (historial de marcaje, SOLO lectura) ---
# Credenciales: Workera -> Editar perfil -> API (habilitar API Key).
WORKERA_API_USER=correo-de-la-cuenta@empresa.cl
WORKERA_API_KEY=api_key_de_32_caracteres
# Opcionales (defaults según Manual API Workera v1.4 CL: headers literales
# API_USER / API_KEY contra api.workera.com; ante 404 el cliente reintenta
# solo con workera.com). Si algo falla: python scripts/verificar_workera.py
# WORKERA_API_BASE_URL=https://api.workera.com/apiClient/v1
# WORKERA_AUTH_STYLE=headers            # headers | basic | bearer
# WORKERA_HEADER_USER=API_USER
# WORKERA_HEADER_KEY=API_KEY
# WORKERA_TIMEOUT_SEGUNDOS=30
# WORKERA_MAX_PAGINAS=20
# WORKERA_MAX_PAGINAS_REPORTE=200        # tope mayor para el reporte mensual
# Rango por defecto del historial: 1 = ayer + hoy (consulta rápida).
# ASISTENCIA_DIAS_DEFECTO=1
# ASISTENCIA_RANGO_MAX_DIAS=62
# Colación (almuerzo) descontada de cada jornada, en horas. Regla de la
# empresa: 2 h para todos. Afecta horas netas, alertas y reportes.
# COLACION_HORAS=2

# --- Supabase (Storage de fotos de pedidos + API) ---
# SUPABASE_URL y SERVICE_ROLE_KEY son OBLIGATORIAS para las fotos de progreso
# (bucket privado pedidos-fotos). La SERVICE_ROLE vive SOLO en el servidor.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_ANON_KEY=sb_publishable_...   (no usada por el backend)
# Opcionales de fotos (defaults):
# FOTOS_BUCKET=pedidos-fotos
# FOTO_MAX_BYTES=5242880                 # 5 MB
# FOTO_MAX_POR_PEDIDO=10
# FOTO_URL_EXPIRA_SEGUNDOS=3600
