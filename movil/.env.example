# URL del backend FastAPI (sin /api al final).
# En desarrollo con Expo Go normalmente NO hace falta: la app infiere la IP
# del PC que sirve el bundle y usa el puerto 8000.
# Para un APK/build real, apunta al backend publicado:
# EXPO_PUBLIC_API_URL=https://backend.maestranzatmg.cl
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
